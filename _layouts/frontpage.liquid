<!doctype html>
<html lang="{{ site.lang }}" data-theme="dark">
  <head>
    {% include head.liquid %}
    <style>
      :root {
        --fp-ground: #0a0a0f;
        --fp-panel: #13131c;
        --fp-panel-hi: #1b1b27;
        --fp-border: #262633;
        --fp-text: #eceaf4;
        --fp-muted: #8b8a9e;
        --fp-accent: #8a6bff;
        --fp-accent-soft: #8a6bff22;
        --fp-cyan: #54e6d6;
        --fp-mono: ui-monospace, "SF Mono", "JetBrains Mono", "Menlo", monospace;
        --fp-sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --fp-maxw: 1404px;
      }

      /* Pin al-folio's theme variables to this page's dark palette, regardless of
         the site-wide light/dark toggle, so global rules like
         `p,h1..h6,div,li,span{color:var(--global-text-color)}` always render light. */
      :root,
      html[data-theme="light"],
      html[data-theme="dark"] {
        --global-bg-color: #0a0a0f;
        --global-text-color: #eceaf4;
        --global-text-color-light: #8b8a9e;
        --global-theme-color: #8a6bff;
        --global-hover-color: #8a6bff;
        --global-card-bg-color: #13131c;
        --global-divider-color: #262633;
      }

      html,
      body.fp-body {
        background: var(--fp-ground) !important;
        margin: 0;
      }
      body.fp-body {
        color: var(--fp-text);
        font-family: var(--fp-sans);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
        overflow-x: hidden;
      }
      body.fp-body a { color: inherit; }
      body.fp-body ::selection { background: var(--fp-accent); color: #fff; }

      /* nav */
      .fp-nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 20;
        display: flex; justify-content: space-between; align-items: center;
        padding: 18px clamp(20px, 5vw, 48px);
        font-family: var(--fp-mono); font-size: 13px;
        backdrop-filter: blur(10px);
        background: linear-gradient(to bottom, #0a0a0fcc, #0a0a0f00);
      }
      .fp-nav .fp-brand { letter-spacing: 0.5px; color: var(--fp-text); text-decoration: none; }
      .fp-nav .fp-brand b { color: var(--fp-accent); }

      /* hero */
      .fp-hero {
        position: relative; min-height: 100svh;
        display: flex; align-items: center;
        padding: 0 clamp(20px, 5vw, 48px); overflow: hidden;
      }
      #fp-field { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .fp-hero::after {
        content: ""; position: absolute; inset: 0; pointer-events: none;
        background:
          radial-gradient(120% 90% at 72% 32%, transparent 38%, #0a0a0f 100%),
          linear-gradient(to bottom, transparent 62%, var(--fp-ground) 100%);
      }
      .fp-hero-inner {
        position: relative; z-index: 2;
        max-width: var(--fp-maxw); width: 100%; margin: 0 auto;
        display: grid; grid-template-columns: auto auto; justify-content: center;
        gap: clamp(48px, 7vw, 110px); align-items: center;
      }
      @media (max-width: 1040px) {
        .fp-hero-inner { grid-template-columns: 1fr; gap: 32px; }
      }

      .fp-eyebrow {
        font-family: var(--fp-mono); font-size: 24px; letter-spacing: 2px;
        text-transform: uppercase; color: var(--fp-accent);
        display: flex; align-items: center; gap: 12px; margin-bottom: 26px;
      }
      .fp-eyebrow::before { content: ""; width: 32px; height: 1px; background: var(--fp-accent); display: inline-block; }
      .fp-hero h1 {
        font-family: var(--fp-mono); font-weight: 600;
        font-size: clamp(2.4rem, 7vw, 6rem); line-height: 0.98;
        letter-spacing: -2px; margin: 0; text-wrap: balance; color: var(--fp-text);
      }
      .fp-hero h1 .fp-dim { color: var(--fp-accent); }
      .fp-role {
        margin: 28px 0 0; font-size: clamp(1.05rem, 2.2vw, 1.35rem);
        max-width: 34ch; color: #cfcdde; line-height: 1.45;
      }
      .fp-role b { color: var(--fp-text); font-weight: 600; }
      .fp-meta-row {
        margin-top: 34px; display: flex; flex-wrap: wrap; gap: 10px 26px;
        font-family: var(--fp-mono); font-size: 21px; color: var(--fp-muted);
      }
      .fp-meta-row a { color: var(--fp-muted); text-decoration: none; transition: color .2s; }
      .fp-meta-row a:hover { color: var(--fp-accent); }

      .fp-socials { margin-top: 38px; display: flex; gap: 14px; flex-wrap: wrap; }
      .fp-socials a {
        font-family: var(--fp-mono); font-size: 17px; text-decoration: none; color: var(--fp-text);
        padding: 16px; border: 1px solid var(--fp-border); border-radius: 999px;
        display: inline-flex; align-items: center; justify-content: center; gap: 14px;
        transition: border-color .2s, color .2s, background .2s, transform .2s;
      }
      .fp-socials a i { font-size: 45px; line-height: 1; width: 45px; text-align: center; }
      .fp-socials a:hover { border-color: var(--fp-accent); color: var(--fp-accent); transform: translateY(-2px); }
      .fp-socials a.fp-primary { background: var(--fp-accent); color: #fff; border-color: var(--fp-accent); }
      .fp-socials a.fp-primary:hover { background: #9b80ff; color: #fff; }

      /* hero portrait */
      .fp-portrait {
        position: relative; justify-self: center; width: 269px; max-width: 100%;
      }
      .fp-portrait::before {
        content: ""; position: absolute; inset: -18px;
        background: radial-gradient(circle at 50% 40%, var(--fp-accent-soft), transparent 70%);
        z-index: -1; pointer-events: none;
      }
      .fp-portrait img {
        width: 100%; height: auto; display: block; border-radius: 18px;
        border: 1px solid var(--fp-border);
        box-shadow: 0 30px 70px -30px #000, 0 0 0 1px #ffffff08 inset;
        filter: saturate(1.02) contrast(1.02);
      }
      @media (max-width: 1040px) {
        .fp-portrait { width: 210px; order: -1; }
      }

      .fp-scrollcue {
        position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 2;
        font-family: var(--fp-mono); font-size: 11px; letter-spacing: 2px; color: var(--fp-muted);
        text-transform: uppercase; display: flex; flex-direction: column; align-items: center; gap: 8px;
      }
      .fp-scrollcue .fp-bar { width: 1px; height: 34px; background: linear-gradient(var(--fp-accent), transparent); }
      .fp-scrollcue .fp-scroll-label { padding-left: 2px; }

      /* bento */
      .fp-wrap { max-width: var(--fp-maxw); margin: 0 auto; padding: 0 clamp(20px, 5vw, 48px) 40px; }
      .fp-section-label {
        font-family: var(--fp-sans); font-size: clamp(1.7rem, 4vw, 2.5rem); font-weight: 700;
        letter-spacing: -1px; color: var(--fp-text); margin: 72px 0 24px;
        display: flex; align-items: center; gap: 20px;
      }
      .fp-section-label::after { content: ""; flex: 1; height: 1px; background: var(--fp-border); }

      .fp-bento { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
      .fp-card {
        background: var(--fp-panel); border: 1px solid var(--fp-border); border-radius: 18px;
        padding: 26px; position: relative; overflow: hidden;
        transition: border-color .25s, transform .25s;
      }
      .fp-card:hover { border-color: #3a3a4d; transform: translateY(-3px); }
      .fp-kicker {
        font-family: var(--fp-mono); font-size: 18px; letter-spacing: 1.5px; text-transform: uppercase;
        color: var(--fp-muted); margin-bottom: 14px;
      }
      .fp-span-2 { grid-column: span 2; }
      .fp-span-3 { grid-column: span 3; }
      .fp-span-4 { grid-column: span 4; }
      .fp-span-6 { grid-column: span 6; }
      @media (max-width: 760px) {
        .fp-bento { grid-template-columns: repeat(2, 1fr); }
        .fp-span-2, .fp-span-3, .fp-span-4, .fp-span-6 { grid-column: span 2; }
      }
      /* intro row: give the currently/previously side a bit more width */
      .fp-bento-intro { grid-template-columns: 1.75fr 1.15fr; }
      .fp-bento-intro > .fp-card { grid-column: auto; }
      @media (max-width: 760px) {
        .fp-bento-intro { grid-template-columns: 1fr; }
      }

      .fp-focus h2 {
        font-family: var(--fp-sans); font-weight: 600;
        font-size: clamp(1.3rem, 3vw, 1.9rem); line-height: 1.3; margin: 0 0 16px; letter-spacing: -0.5px;
      }
      .fp-hl { color: var(--fp-accent); }
      .fp-focus p { color: var(--fp-muted); margin: 0; font-size: 0.95rem; }
      .fp-tags { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
      .fp-tag {
        font-family: var(--fp-sans); font-weight: 500; color: var(--fp-text);
        font-size: clamp(calc(1.3rem - 5px), calc(3vw - 5px), calc(1.9rem - 5px)); line-height: 1.2; letter-spacing: -0.5px;
        background: var(--fp-panel-hi); border: 1px solid var(--fp-border);
        padding: 10px 18px; border-radius: 14px;
      }
      .fp-tag::before { content: "› "; color: var(--fp-accent); }

      .fp-now h3 { margin: 0 0 6px; font-size: 1.45rem; }
      .fp-now .fp-loc { color: var(--fp-muted); font-size: 0.92rem; }
      .fp-now .fp-glow {
        position: absolute; right: -40px; top: -40px; width: 160px; height: 160px;
        background: radial-gradient(circle, var(--fp-accent-soft), transparent 70%); pointer-events: none;
      }

      .fp-paper { display: grid; grid-template-columns: 340px 1fr; gap: 32px; align-items: center; padding: 28px; }
      .fp-paper .fp-thumb { overflow: hidden; border-radius: 12px; border: 1px solid var(--fp-border); background: var(--fp-panel-hi); }
      .fp-paper .fp-thumb img { width: 100%; height: auto; display: block; }
      .fp-paper-body { display: flex; flex-direction: column; min-width: 0; }
      .fp-paper .fp-venue {
        font-family: var(--fp-mono); font-size: 13px; letter-spacing: 1px; color: var(--fp-cyan); margin-bottom: 14px;
      }
      .fp-paper h3 { font-size: clamp(1.2rem, 2.4vw, 1.55rem); line-height: 1.32; margin: 0 0 14px; font-weight: 600; letter-spacing: -0.3px; }
      .fp-paper .fp-authors { color: var(--fp-muted); font-size: 1.02rem; margin-bottom: 20px; }
      .fp-paper .fp-authors b { color: var(--fp-text); font-weight: 600; }
      .fp-paper .fp-pl { display: flex; gap: 20px; font-family: var(--fp-mono); font-size: 14px; flex-wrap: wrap; }
      .fp-paper .fp-pl a { color: var(--fp-accent); text-decoration: none; }
      .fp-paper .fp-pl a:hover { text-decoration: underline; }
      @media (max-width: 680px) {
        .fp-paper { grid-template-columns: 1fr; gap: 22px; }
      }

      .fp-news ul { list-style: none; padding: 0; margin: 0; }
      .fp-news li { display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--fp-border); }
      .fp-news li:last-child { border-bottom: 0; }
      .fp-news .fp-date { font-family: var(--fp-mono); font-size: 18px; color: var(--fp-cyan); white-space: nowrap; }
      .fp-news .fp-what { font-size: 21px; }


      .fp-footer {
        border-top: 1px solid var(--fp-border); margin: 40px auto 0; max-width: var(--fp-maxw);
        padding: 30px clamp(20px, 5vw, 48px);
        font-family: var(--fp-mono); font-size: 12px; color: var(--fp-muted);
        display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
      }
      .fp-footer a { color: var(--fp-muted); text-decoration: none; }
      .fp-footer a:hover { color: var(--fp-accent); }

      .fp-reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
      .fp-reveal.fp-in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        .fp-reveal { opacity: 1; transform: none; transition: none; }
      }
    </style>
  </head>

  <body class="fp-body">
    {% assign given = page.given_name | default: site.first_name %}
    {% assign family = page.family_name | default: site.last_name %}
    {% assign name = given | append: ' ' | append: family %}


    <header class="fp-hero">
      <canvas id="fp-field"></canvas>
      <div class="fp-hero-inner">
        <div>
          {% if page.subtitle %}<div class="fp-eyebrow">{{ page.subtitle }}</div>{% endif %}
          <h1>{{ given }}<br />{{ family }}<span class="fp-dim">.</span></h1>
          {% if page.hero_role %}<p class="fp-role">{{ page.hero_role }}</p>{% endif %}
          {% if page.affiliations %}
            <div class="fp-meta-row">
              {% for aff in page.affiliations %}
                {% if aff.url %}<a href="{{ aff.url }}" target="_blank" rel="noopener noreferrer">{{ aff.text }} ↗</a>
                {% else %}<span>{{ aff.text }}</span>{% endif %}
              {% endfor %}
            </div>
          {% endif %}
          {% if page.socials %}
            <div class="fp-socials">
              {% for s in page.socials %}
                <a href="{{ s.url | relative_url }}" title="{{ s.text }}" {% if s.primary %}class="fp-primary"{% endif %}
                  {% unless s.url contains 'mailto' %}target="_blank" rel="noopener noreferrer"{% endunless %}>{% if s.icon %}<i class="{{ s.icon }}"></i>{% endif %}{% unless s.icon_only %}{{ s.text }}{% endunless %}</a>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        {% if page.profile.image %}
          <div class="fp-portrait fp-reveal">
            <img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="{{ name }}" loading="eager" />
          </div>
        {% endif %}
      </div>
      <div class="fp-scrollcue"><span class="fp-scroll-label">scroll</span><span class="fp-bar"></span></div>
    </header>

    <main class="fp-wrap">
      <!-- intro: research focus + standing -->
      <section class="fp-bento fp-bento-intro" style="margin-top: 64px">
        <article class="fp-card fp-focus fp-span-4 fp-reveal">
          <div class="fp-kicker">research focus</div>
          {% if page.focus_statement %}<h2>{{ page.focus_statement }}</h2>{% endif %}
          {% if page.focus_detail %}<p>{{ page.focus_detail }}</p>{% endif %}
          {% if page.focus_tags %}
            <div class="fp-tags">
              {% for t in page.focus_tags %}<span class="fp-tag">{{ t }}</span>{% endfor %}
            </div>
          {% endif %}
        </article>

        <article class="fp-card fp-now fp-span-2 fp-reveal">
          <div class="fp-glow"></div>
          {% for item in page.now %}
            <div class="fp-kicker">{{ item.label }}</div>
            <h3>{{ item.role }}</h3>
            <div class="fp-loc">{{ item.place }}</div>
            {% unless forloop.last %}<div style="height: 18px"></div>{% endunless %}
          {% endfor %}
        </article>
      </section>

      <!-- news -->
      <div class="fp-section-label fp-reveal" id="fp-news">news</div>
      <section class="fp-bento">
        <article class="fp-card fp-news fp-span-6 fp-reveal">
          <ul>
            {% assign news = site.news | reverse %}
            {% for item in news limit: 5 %}
              <li>
                <span class="fp-date">{{ item.date | date: '%b %Y' }}</span>
                <span class="fp-what">{{ item.content | remove: '<p>' | remove: '</p>' | strip_newlines | emojify }}</span>
              </li>
            {% endfor %}
          </ul>
        </article>
      </section>

      <!-- publications -->
      <div class="fp-section-label fp-reveal" id="fp-pubs">publications</div>
      <section class="fp-bento">
        {% for work in page.selected_works %}
          <article class="fp-card fp-paper fp-span-6 fp-reveal">
            {% if work.image %}
              <div class="fp-thumb">
                <img src="{{ work.image | relative_url }}" alt="{{ work.title }}" loading="lazy" />
              </div>
            {% endif %}
            <div class="fp-paper-body">
              <div class="fp-venue">▣ {{ work.venue }}</div>
              <h3>{{ work.title }}</h3>
              <div class="fp-authors">{{ work.authors }}</div>
              <div class="fp-pl">
                {% if work.website %}<a href="{{ work.website }}" target="_blank" rel="noopener noreferrer">project ↗</a>{% endif %}
                {% if work.arxiv %}<a href="{{ work.arxiv }}" target="_blank" rel="noopener noreferrer">arXiv</a>{% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </section>
    </main>

    <footer class="fp-footer">
      <span>© {{ site.time | date: '%Y' }} {{ name }}</span>
    </footer>

    <script>
      (function () {
        var canvas = document.getElementById("fp-field");
        if (!canvas) return;
        var ctx = canvas.getContext("2d");
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var w, h, dpr, particles = [];
        var mouse = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5 };

        function lerpColor(t) {
          var r = Math.round(138 + (84 - 138) * t);
          var g = Math.round(107 + (230 - 107) * t);
          var b = Math.round(255 + (214 - 255) * t);
          return [r, g, b];
        }
        function resize() {
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          w = canvas.clientWidth; h = canvas.clientHeight;
          canvas.width = w * dpr; canvas.height = h * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        function init() {
          resize();
          var count = Math.min(170, Math.floor((w * h) / 9000));
          particles = [];
          for (var i = 0; i < count; i++) {
            var z = Math.random();
            particles.push({
              x: Math.random(), y: Math.random(), z: z,
              r: 0.6 + z * 2.4, sp: 0.02 + z * 0.06, ph: Math.random() * Math.PI * 2,
            });
          }
        }
        function draw(time) {
          ctx.clearRect(0, 0, w, h);
          mouse.x += (mouse.tx - mouse.x) * 0.05;
          mouse.y += (mouse.ty - mouse.y) * 0.05;
          var px = mouse.x - 0.5, py = mouse.y - 0.5;
          for (var i = 0; i < particles.length; i++) {
            var p = particles[i];
            p.y -= p.sp * 0.0016 * (reduce ? 0 : 1);
            if (p.y < -0.05) { p.y = 1.05; p.x = Math.random(); }
            var parX = px * p.z * 60, parY = py * p.z * 60;
            var bob = reduce ? 0 : Math.sin(time * 0.0003 + p.ph) * 4 * p.z;
            var sx = p.x * w + parX + bob, sy = p.y * h + parY;
            var col = lerpColor(p.z), alpha = 0.15 + p.z * 0.5;
            ctx.beginPath();
            ctx.arc(sx, sy, p.r, 0, Math.PI * 2);
            ctx.fillStyle = "rgba(" + col[0] + "," + col[1] + "," + col[2] + "," + alpha + ")";
            ctx.shadowBlur = p.z * 10;
            ctx.shadowColor = "rgba(" + col[0] + "," + col[1] + "," + col[2] + ",0.6)";
            ctx.fill();
          }
          ctx.shadowBlur = 0;
          if (!reduce) requestAnimationFrame(draw);
        }
        window.addEventListener("resize", function () { resize(); init(); });
        window.addEventListener("pointermove", function (e) {
          mouse.tx = e.clientX / window.innerWidth;
          mouse.ty = e.clientY / window.innerHeight;
        });
        init();
        if (reduce) draw(0); else requestAnimationFrame(draw);

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { if (en.isIntersecting) en.target.classList.add("fp-in"); });
        }, { threshold: 0.12 });
        document.querySelectorAll(".fp-reveal").forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
